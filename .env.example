# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # секретный ключ, только на сервере, никогда во фронтенде
# Разрешённые источники для CORS через запятую (адрес фронтенда). Пусто = только тот же домен
CORS_ORIGINS=http://localhost:3000
PORT=3000
# Адрес публичного веб-сервиса для ссылок в SMS; без завершающего /
PUBLIC_BASE_URL=https://your-crm.example
REQUEST_LOGGING=true
# Для включения адаптеров задайте реальные значения через окружение сервера
PAYME_KEY=
PAYME_MERCHANT_ID=
CLICK_SECRET=
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
EXTERNAL_FORM_SECRET=
EXTERNAL_FORM_ACTOR_ID=
TELEPHONY_SECRET=
TELEPHONY_ACTOR_ID=
OTP_SECRET=
# 32 случайных байта в hex. Одинаковый ключ у web и worker.
NOTIFICATION_ENCRYPTION_KEY=
ESKIZ_TOKEN=
ESKIZ_FROM=
TELEGRAM_BOT_TOKEN=
WEBHOOK_ALLOWED_HOSTS=
WEBHOOK_SECRET_EXAMPLE=
# Включать только после настройки и проверки провайдеров
WORKER_SEND_ENABLED=false
